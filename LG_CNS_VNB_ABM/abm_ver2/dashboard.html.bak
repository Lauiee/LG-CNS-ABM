  </g>

  <!-- neck (outside clip so it overlaps body) -->
  <rect x="55" y="58" width="10" height="20" rx="5" fill="${skinM}" opacity="${att ? ".22" : "1"}"/>

  <!-- ── HEAD ── -->
  <g transform="${tilt}" opacity="${att ? ".38" : "1"}">
