    <!-- sideburns -->
    <rect x="38" y="38" width="4" height="14" rx="2" fill="${hair}" opacity="${att ? ".18" : ".75"}"/>
    <rect x="78" y="38" width="4" height="14" rx="2" fill="${hair}" opacity="${att ? ".18" : ".75"}"/>

    <!-- ── EYEBROWS ── -->
    ${
      att
        ? ""
        : tired
          ? `
      <path d="M44,30 Q52,33 59,30" stroke="${hair}" stroke-width="2.2" fill="none" stroke-linecap="round" opacity=".65"/>
      <path d="M61,30 Q68,33 76,30" stroke="${hair}" stroke-width="2.2" fill="none" stroke-linecap="round" opacity=".65"/>
    `
          : burnout
            ? `
      <path d="M44,29 Q52,25 59,29" stroke="${hair}" stroke-width="2.5" fill="none" stroke-linecap="round"/>
      <path d="M61,29 Q68,25 76,29" stroke="${hair}" stroke-width="2.5" fill="none" stroke-linecap="round"/>
    `
            : flow
