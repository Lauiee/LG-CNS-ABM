    <!-- ── EYES ── -->
    ${
      att
        ? `
      <line x1="45" y1="37" x2="57" y2="46" stroke="#383838" stroke-width="2.8" stroke-linecap="round"/>
      <line x1="57" y1="37" x2="45" y2="46" stroke="#383838" stroke-width="2.8" stroke-linecap="round"/>
      <line x1="63" y1="37" x2="75" y2="46" stroke="#383838" stroke-width="2.8" stroke-linecap="round"/>
      <line x1="75" y1="37" x2="63" y2="46" stroke="#383838" stroke-width="2.8" stroke-linecap="round"/>
    `
        : tired
          ? `
      <ellipse cx="51" cy="40" rx="6.5" ry="3.5" fill="#100800"/>
      <ellipse cx="69" cy="40" rx="6.5" ry="3.5" fill="#100800"/>
      <line x1="44" y1="36" x2="58" y2="36" stroke="${skinD}" stroke-width="2.2" stroke-linecap="round"/>
      <line x1="62" y1="36" x2="76" y2="36" stroke="${skinD}" stroke-width="2.2" stroke-linecap="round"/>
      <circle cx="50" cy="41" r="1.8" fill="white" opacity=".28"/>
      <circle cx="68" cy="41" r="1.8" fill="white" opacity=".28"/>
    `
          : burnout
            ? `
      <ellipse cx="51" cy="40" rx="6"   ry="6.5" fill="#0e0400"/>
      <ellipse cx="69" cy="40" rx="6"   ry="6.5" fill="#0e0400"/>
      <line x1="44" y1="35" x2="58" y2="37.5" stroke="${skinD}" stroke-width="2" stroke-linecap="round"/>
      <line x1="62" y1="37.5" x2="76" y2="35" stroke="${skinD}" stroke-width="2" stroke-linecap="round"/>
      <circle cx="50" cy="41" r="2"   fill="white" opacity=".14"/>
      <circle cx="68" cy="41" r="2"   fill="white" opacity=".14"/>
    `
            : flow
              ? `
      <ellipse cx="51" cy="40" rx="6.5" ry="7"   fill="#060300"/>
      <ellipse cx="69" cy="40" rx="6.5" ry="7"   fill="#060300"/>
      <circle  cx="54" cy="37" r="2.8" fill="white" opacity=".95"/>
      <circle  cx="72" cy="37" r="2.8" fill="white" opacity=".95"/>
      <circle  cx="51" cy="42" r="1.8" fill="${sc}"  opacity=".8"/>
      <circle  cx="69" cy="42" r="1.8" fill="${sc}"  opacity=".8"/>
      <circle  cx="55" cy="35.5" r="1.2" fill="white" opacity=".6"/>
      <circle  cx="73" cy="35.5" r="1.2" fill="white" opacity=".6"/>
    `
              : `
      <ellipse cx="51" cy="40" rx="6"   ry="6.5" fill="#100800"/>
      <ellipse cx="69" cy="40" rx="6"   ry="6.5" fill="#100800"/>
      <circle  cx="54" cy="37" r="2.5" fill="white" opacity=".88"/>
      <circle  cx="72" cy="37" r="2.5" fill="white" opacity=".88"/>
      <circle  cx="56" cy="35.5" r="1.1" fill="white" opacity=".45"/>
      <circle  cx="74" cy="35.5" r="1.1" fill="white" opacity=".45"/>
    `
    }

    <!-- nose (minimal) -->
    <path d="M58,50 Q55.5,56 57.5,58.5 Q60,60 62.5,58.5 Q64.5,56 62,50"
          fill="none" stroke="${skinD}" stroke-width="1.1" opacity=".25" stroke-linecap="round"/>

    <!-- ── MOUTH ── -->
    ${
      att
        ? `
      <line x1="47" y1="58" x2="73" y2="58" stroke="${skinD}" stroke-width="1.8" stroke-linecap="round" opacity=".32"/>
    `
        : tired
          ? `
      <path d="M47,58 Q60,61 73,58" stroke="${skinD}" stroke-width="1.7" fill="none" stroke-linecap="round"/>
    `
          : burnout
            ? `
      <path d="M48,62 Q60,57 72,62" stroke="#7a2010" stroke-width="1.9" fill="none" stroke-linecap="round"/>
    `
            : flow
              ? `
      <path d="M48,58 Q60,65 72,58" stroke="#9a5020" stroke-width="1.7" fill="none" stroke-linecap="round"/>
      <path d="M50,58.5 Q60,64.5 70,58.5" fill="white" opacity=".11"/>
    `
              : `
      <path d="M48,58 Q60,63 72,58" stroke="#985020" stroke-width="1.6" fill="none" stroke-linecap="round"/>
    `
    }

    <!-- state wash on face -->
    <ellipse cx="60" cy="42" rx="20" ry="21" fill="${sc}" opacity="${flow ? ".06" : burnout ? ".06" : "0.03"}"/>

    <!-- ── PL GLASSES ── -->
    ${
      agent.is_pl
        ? `
    <rect x="40" y="35" width="19" height="13" rx="5.5" fill="none" stroke="#8b5cf6" stroke-width="1.6" opacity=".9" filter="url(#gf3${id})"/>
    <rect x="61" y="35" width="19" height="13" rx="5.5" fill="none" stroke="#8b5cf6" stroke-width="1.6" opacity=".9" filter="url(#gf3${id})"/>
    <line x1="59" y1="41.5" x2="61" y2="41.5" stroke="#8b5cf6" stroke-width="1.4" opacity=".9"/>
    <line x1="39" y1="41.5" x2="40" y2="41.5" stroke="#8b5cf6" stroke-width="1.4" opacity=".6"/>
    <line x1="80" y1="41.5" x2="81" y2="41.5" stroke="#8b5cf6" stroke-width="1.4" opacity=".6"/>
    <rect x="41" y="36"  width="17" height="11" rx="4.5" fill="#8b5cf6" opacity=".09"/>
    <rect x="62" y="36"  width="17" height="11" rx="4.5" fill="#8b5cf6" opacity=".09"/>
    `
        : ""
    }
  </g>

  <!-- ── PL CROWN (above hex) ── -->
  ${
    agent.is_pl
      ? `
  <g transform="translate(60,12)" filter="url(#gf2${id})">
    <path d="M-15,4 L-15,-13 L-8,-8.5 L0,-16 L8,-8.5 L15,-13 L15,4Z" fill="#f59e0b" opacity=".55"/>
  </g>
  <g transform="translate(60,12)">
    <path d="M-15,4 L-15,-13 L-8,-8.5 L0,-16 L8,-8.5 L15,-13 L15,4Z" fill="#f59e0b"/>
    <rect x="-15" y="4" width="30" height="5.5" rx="2.75" fill="#d97706"/>
    <circle cx="-8"  cy="-10"  r="2.4" fill="white" opacity=".85"/>
    <circle cx="0"   cy="-13"  r="2.4" fill="white" opacity=".85"/>
    <circle cx="8"   cy="-10"  r="2.4" fill="white" opacity=".85"/>
    <circle cx="-8"  cy="-10"  r="1.2" fill="#fff8d0" opacity=".95"/>
    <circle cx="0"   cy="-13"  r="1.2" fill="#fff8d0" opacity=".95"/>
    <circle cx="8"   cy="-10"  r="1.2" fill="#fff8d0" opacity=".95"/>
  </g>
  `
      : ""
  }

  <!-- ── FLOW SPARKS ── -->
  ${
    flow
      ? `
  <polygon points="${HX}" fill="none" stroke="#10b981" stroke-width="2.5" opacity=".35">
    <animate attributeName="stroke-opacity" values=".35;.05;.35" dur="1.4s" repeatCount="indefinite"/>
    <animate attributeName="stroke-width"   values="2.5;5;2.5"    dur="1.4s" repeatCount="indefinite"/>
  </polygon>
  <circle cx="110" cy="22" r="3.2" fill="#34d399" opacity=".9">
    <animate attributeName="cy" values="22;12;22" dur="2s"   repeatCount="indefinite"/>
    <animate attributeName="opacity" values=".9;.1;.9" dur="2s" repeatCount="indefinite"/>
  </circle>
  <circle cx="10"  cy="32" r="2.6" fill="#6ee7b7" opacity=".78">
    <animate attributeName="cy" values="32;22;32" dur="2.5s" repeatCount="indefinite"/>
    <animate attributeName="opacity" values=".78;.1;.78" dur="2.5s" repeatCount="indefinite"/>
  </circle>
  <circle cx="113" cy="56" r="2"   fill="#10b981" opacity=".6">
    <animate attributeName="cy" values="56;45;56" dur="1.8s" repeatCount="indefinite" begin=".8s"/>
  </circle>
  <circle cx="7"   cy="72" r="1.7" fill="#34d399" opacity=".5">
    <animate attributeName="cy" values="72;60;72" dur="2.2s" repeatCount="indefinite" begin=".4s"/>
  </circle>
  `
      : ""
  }

  <!-- ── INTERRUPTED ── -->
  ${
    inter
      ? `
  <polygon points="${HX}" fill="none" stroke="#f59e0b" stroke-width="2.5" opacity=".5">
    <animate attributeName="stroke-opacity" values=".5;.08;.5" dur=".42s" repeatCount="indefinite"/>
  </polygon>
  <g filter="url(#gf2${id})">
    <text x="90" y="29" font-size="19" font-weight="900" fill="#f59e0b" font-family="monospace" opacity=".75">!</text>
  </g>
  <text x="90" y="29" font-size="19" font-weight="900" fill="#f59e0b" font-family="monospace">!</text>
  `
      : ""
  }

  <!-- ── BURNOUT ── -->
  ${
    burnout
      ? `
  <polygon points="${HX}" fill="none" stroke="#ef4444" stroke-width="2.5" opacity=".4">
    <animate attributeName="stroke-opacity" values=".4;.06;.4" dur="1.1s" repeatCount="indefinite"/>
  </polygon>
  <g filter="url(#gf2${id})">
    <text x="87" y="30" font-size="17" fill="#ef4444" opacity=".65">✕</text>
    <text x="7"  y="30" font-size="17" fill="#ef4444" opacity=".65">✕</text>
  </g>
  <text x="87" y="30" font-size="17" fill="#ef4444" opacity=".55">✕</text>
  <text x="7"  y="30" font-size="17" fill="#ef4444" opacity=".55">✕</text>
  `
      : ""
  }

  <!-- ── STATUS DOT (bottom-right) ── -->
  <circle cx="99" cy="110" r="9"   fill="#070d1c" stroke="${sc}" stroke-width="2"/>
  <circle cx="99" cy="110" r="4.5" fill="${sc}" opacity="${att ? ".18" : "1"}">
    ${flow ? '<animate attributeName="opacity" values="1;.22;1" dur="1s" repeatCount="indefinite"/>' : ""}
  </circle>
</svg>`;
      }

      // ── 차트 그리기 ──
      function drawSparkline(canvasId, data, color, label) {
        const canvas = document.getElementById(canvasId);
        if (!canvas || data.length < 2) return;
        const ctx = canvas.getContext("2d");
        const W = canvas.offsetWidth || 300;
        const H = 80;
        canvas.width = W;
        canvas.height = H;

        ctx.clearRect(0, 0, W, H);

        const min = Math.min(...data);
        const max = Math.max(...data);
        const range = max - min || 1;

        const pts = data.map((v, i) => ({
          x: (i / (data.length - 1)) * (W - 2) + 1,
          y: H - 4 - ((v - min) / range) * (H - 16),
        }));

        // 그라디언트 배경
        const grad = ctx.createLinearGradient(0, 0, 0, H);
        grad.addColorStop(0, color + "33");
        grad.addColorStop(1, color + "00");
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.moveTo(pts[0].x, H);
        pts.forEach((p) => ctx.lineTo(p.x, p.y));
        ctx.lineTo(pts[pts.length - 1].x, H);
        ctx.closePath();
        ctx.fill();

        // 선
        ctx.strokeStyle = color;
        ctx.lineWidth = 1.5;
        ctx.lineJoin = "round";
        ctx.beginPath();
        pts.forEach((p, i) =>
          i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y),
        );
        ctx.stroke();

        // 마지막 점
        const last = pts[pts.length - 1];
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.arc(last.x, last.y, 3, 0, Math.PI * 2);
        ctx.fill();

        // 현재 값 레이블
        ctx.fillStyle = color;
        ctx.font = "500 11px IBM Plex Mono, monospace";
        ctx.textAlign = "right";
        ctx.fillText(data[data.length - 1].toFixed(1), W - 4, 14);

        // 격자
        ctx.strokeStyle = "#1e2330";
        ctx.lineWidth = 0.5;
        [0.25, 0.5, 0.75].forEach((t) => {
          const y = H - 4 - t * (H - 16);
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(W, y);
          ctx.stroke();
        });
      }

      // ── 전역 데이터 ──
      let simData = null;
      let currentStep = 0;
      let animTimer = null;
      let currentView = "simulation";
      const logs = [];

      // ── 시뮬레이션 실행 ──
      async function runSimulation() {
        const params = {
          num_developers: parseInt(document.getElementById("p-devs").value),
          num_sprints: parseInt(document.getElementById("p-sprints").value),
          meeting_load: parseFloat(document.getElementById("p-meeting").value),
          review_strictness: parseFloat(
            document.getElementById("p-review").value,
          ),
          codebase_stability: parseFloat(
            document.getElementById("p-stability").value,
          ),
          collaboration_tendency: parseFloat(
            document.getElementById("p-collab").value,
          ),
          requirement_clarity: parseFloat(
            document.getElementById("p-req").value,
          ),
          seed: parseInt(document.getElementById("p-seed").value),
        };

        document.getElementById("statusDot").className = "status-dot running";
        document.getElementById("statusText").textContent =
          "시뮬레이션 실행중...";

        try {
          const res = await fetch("/simulate", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(params),
          });
          simData = await res.json();
        } catch (e) {
          // 서버 없을 때: 내장 데모 데이터 생성
          simData = generateDemoData(params);
        }

        document.getElementById("statusDot").className = "status-dot ready";
        document.getElementById("statusText").textContent = "준비됨";

        initUI();
        jumpToStep(0);

        document.getElementById("playBtn").disabled = false;
        document.getElementById("resetBtn").disabled = false;
        document.getElementById("toggleViewBtn").disabled = false;
      }

      // ── 데모 데이터 생성 (서버 없을 때) ──
      function generateDemoData(params) {
        const nd = params.num_developers;
        const ns = params.num_sprints;
        const total = ns * 10;
        const snapshots = [];
        const STATES = [
          "Coding",
          "FlowCoding",
          "Reviewing",
          "Communicating",
          "Interrupted",
          "Idle",
        ];

        // 초기 에너지/동기부여 상태
        let teamEnergy = Array(nd).fill(100);
        let teamMotivation = Array(nd).fill(70);
        let teamKnowledge = Array(nd)
          .fill(0)
          .map((_, i) => 20 + i * 5);
        let prs = Array(nd).fill(0);
        let totalDeploys = 0;
        let totalIncidents = 0;

        for (let step = 1; step <= total; step++) {
          // 주말 회복
          if (step % 5 === 0) {
            teamEnergy = teamEnergy.map((e) => Math.min(100, e + 25));
            teamMotivation = teamMotivation.map((m) => Math.min(100, m + 5));
          }

          // 일별 소모
          teamEnergy = teamEnergy.map((e) =>
            Math.max(10, e - 4 - Math.random() * 3),
          );
          teamMotivation = teamMotivation.map((m) => Math.max(20, m - 0.2));
          teamKnowledge = teamKnowledge.map((k) =>
            Math.min(100, k + Math.random() * 2),
          );

          // PR 생성
          for (let i = 0; i < nd; i++) {
            if (Math.random() < 0.35) prs[i]++;
          }

          if (Math.random() < 0.3) totalDeploys++;
          if (Math.random() < 0.05) totalIncidents++;

          const sprint = Math.ceil(step / 10);
          // sprint 종료 시 motivation 보너스
          if (step % 10 === 0) {
            teamMotivation = teamMotivation.map((m) => Math.min(100, m + 8));
          }

          const stateWeights = {
            Coding: 0.4,
            FlowCoding: 0.15,
            Reviewing: 0.15,
            Communicating: 0.1,
            Interrupted: 0.1,
            Idle: 0.1,
          };
          const stateKeys = Object.keys(stateWeights);
          const stateVals = Object.values(stateWeights);

          snapshots.push({
            step,
            sprint,
            agents: Array(nd)
              .fill(0)
              .map((_, i) => {
                const r = Math.random();
                let cumul = 0;
                let st = "Idle";
                for (let j = 0; j < stateKeys.length; j++) {
                  cumul += stateVals[j];
                  if (r < cumul) {
                    st = stateKeys[j];
                    break;
                  }
                }
                return {
                  id: i + 1,
                  skill: [0.5, 1.0, 1.0, 1.5, 1.5, 1.5, 2.0, 2.0, 2.5][i % 9],
                  energy: teamEnergy[i],
                  motivation: teamMotivation[i],
                  knowledge: teamKnowledge[i],
                  state: teamEnergy[i] < 20 ? "Burnout" : st,
                  attrited: false,
                  prs: prs[i],
                  flow_streak:
                    st === "FlowCoding" ? 3 + Math.floor(Math.random() * 5) : 0,
                  is_pl: false,
                };
              })
              .concat([
                {
                  id: nd + 1,
                  skill: 3.0,
                  energy: Math.min(100, 70 + Math.random() * 20),
                  motivation: 80,
                  knowledge: 80,
                  state: step % 10 === 1 ? "Planning" : "TaskAssigning",
                  attrited: false,
                  prs: 0,
                  flow_streak: 0,
                  is_pl: true,
                },
              ]),
            metrics: {
              avg_energy: teamEnergy.reduce((a, b) => a + b, 0) / nd,
              avg_motivation: teamMotivation.reduce((a, b) => a + b, 0) / nd,
              avg_knowledge: teamKnowledge.reduce((a, b) => a + b, 0) / nd,
              total_prs: prs.reduce((a, b) => a + b, 0),
              deployments: totalDeploys,
              incidents: totalIncidents,
              active_devs: nd,
            },
          });
        }

        const finalPRs = prs.reduce((a, b) => a + b, 0) / nd;
        return {
          params,
          snapshots,
          prism: {
            "PRs per Engineer": +finalPRs.toFixed(2),
            "Lead Time (steps)": +(3 + Math.random() * 3).toFixed(2),
            "Deployment Frequency": +(totalDeploys / ns).toFixed(2),
            "Change Failure Rate (%)": +(
              (totalIncidents / Math.max(totalDeploys, 1)) *
              100
            ).toFixed(1),
            "Recovery Time (steps)": 0,
            "% Time on New Capabilities": +(50 + Math.random() * 20).toFixed(1),
          },
          total_steps: ns * 10,
          num_sprints: ns,
        };
      }

      // ── UI 초기화 ──
      function initUI() {
        const total = simData.total_steps;
        const ns = simData.num_sprints;

        // 타임라인
        const tl = document.getElementById("timelineSteps");
        tl.innerHTML = "";
        for (let i = 0; i < total; i++) {
          const pip = document.createElement("div");
          pip.className =
            "step-pip" + ((i + 1) % 10 === 0 ? " sprint-end" : "");
          pip.title = `Step ${i + 1}`;
          pip.onclick = () => jumpToStep(i);
          tl.appendChild(pip);
        }

        // 스프린트 핍
        const sp = document.getElementById("sprintPips");
        sp.innerHTML = "";
        for (let i = 0; i < ns; i++) {
          const pip = document.createElement("div");
          pip.className = "sprint-pip";
          pip.id = `sp-${i}`;
          sp.appendChild(pip);
        }
      }

      // ── 특정 step으로 이동 ──
      function jumpToStep(idx) {
        if (!simData) return;
        currentStep = Math.max(0, Math.min(idx, simData.snapshots.length - 1));
        renderStep(simData.snapshots[currentStep]);
        updateTimeline();
        updateCharts();
      }

      // ── step 렌더링 ──
      function renderStep(snap) {
        // 헤더
        document.getElementById("stepLabel").textContent =
          `STEP ${snap.step}/${simData.total_steps}`;
        document.getElementById("sprintLabel").textContent =
          `SPRINT ${snap.sprint}/${simData.num_sprints}`;

        const pct = ((snap.step / simData.total_steps) * 100).toFixed(0);
        document.getElementById("progressFill").style.width = pct + "%";
        document.getElementById("progressPct").textContent = pct + "%";

        // 스프린트 핍
        for (let i = 0; i < simData.num_sprints; i++) {
          const pip = document.getElementById(`sp-${i}`);
          if (!pip) continue;
          const sprintDone = snap.sprint > i + 1;
          const sprintCurrent = snap.sprint === i + 1;
          pip.className =
            "sprint-pip" +
            (sprintDone ? " done" : sprintCurrent ? " current" : "");
        }

        // 지표 (최종 프레임워크 값)
        const fw = simData.prism;
        document.getElementById("m-prs").textContent = fw["PRs per Engineer"];
        document.getElementById("m-lt").innerHTML =
          fw["Lead Time (steps)"] + '<span class="metric-unit">step</span>';
        document.getElementById("m-df").innerHTML =
          fw["Deployment Frequency"] +
          '<span class="metric-unit">/sprint</span>';
        document.getElementById("m-cfr").innerHTML =
          fw["Change Failure Rate (%)"] + '<span class="metric-unit">%</span>';
        document.getElementById("m-rt").innerHTML =
          fw["Recovery Time (steps)"] + '<span class="metric-unit">step</span>';
        document.getElementById("m-nc").innerHTML =
          fw["% Time on New Capabilities"] +
          '<span class="metric-unit">%</span>';

        // 실시간 상태 바
        document.getElementById("rt-devs").textContent =
          snap.metrics.active_devs;
        document.getElementById("rt-energy").textContent =
          snap.metrics.avg_energy.toFixed(0);
        document.getElementById("rt-motivation").textContent =
          snap.metrics.avg_motivation.toFixed(0);
        document.getElementById("rt-prs").textContent = snap.metrics.total_prs;
        document.getElementById("rt-deploys").textContent =
          snap.metrics.deployments;
        document.getElementById("rt-incidents").textContent =
          snap.metrics.incidents;

        // Agent 그리드
        renderAgents(snap.agents);

        // 로그
        addLog(snap);
      }

      // ── Agent 렌더링 ──
      function renderAgents(agents) {
        const grid = document.getElementById("agentGrid");
        grid.innerHTML = "";

        agents.forEach((agent) => {
          const card = document.createElement("div");
          card.className = `dev-card state-${agent.state}${agent.is_pl ? " is-pl" : ""}`;

          const energyColor =
            agent.energy > 60
              ? "#10b981"
              : agent.energy > 30
                ? "#f59e0b"
                : "#ef4444";

          const tooltip = `
      <div class="dev-tooltip">
        <div class="tt-row"><span>상태</span><span class="tt-val">${agent.state}</span></div>
        <div class="tt-row"><span>스킬</span><span class="tt-val">L${agent.skill}</span></div>
        <div class="tt-row"><span>에너지</span><span class="tt-val">${agent.energy.toFixed(0)}</span></div>
        <div class="tt-row"><span>동기부여</span><span class="tt-val">${agent.motivation.toFixed(0)}</span></div>
        <div class="tt-row"><span>지식</span><span class="tt-val">${agent.knowledge.toFixed(0)}</span></div>
        <div class="tt-row"><span>PRs</span><span class="tt-val">${agent.prs}</span></div>
      </div>`;

          card.innerHTML = `
      ${tooltip}
      <div class="dev-figure-frame">
        <div class="dev-figure">${devSVG(agent)}</div>
      </div>
      <div class="energy-bar">
        <div class="energy-fill" style="width:${agent.energy}%;background:${energyColor}"></div>
      </div>
      <div class="state-badge" style="color:${STATE_COLORS[agent.state] || "#4a5568"}">
        ${agent.state.toLowerCase()}
      </div>
      <div class="dev-id">${agent.is_pl ? "👑 PL" : `#${agent.id} L${agent.skill}`}</div>`;

          grid.appendChild(card);
        });
      }

      // ── 차트 업데이트 ──
      function updateCharts() {
        const history = simData.snapshots.slice(0, currentStep + 1);
        drawSparkline(
          "chartEnergy",
          history.map((s) => s.metrics.avg_energy),
          "#3b82f6",
          "Energy",
        );
        drawSparkline(
          "chartMotivation",
          history.map((s) => s.metrics.avg_motivation),
          "#10b981",
          "Motivation",
        );
        drawSparkline(
          "chartPRs",
          history.map((s) => s.metrics.total_prs),
          "#8b5cf6",
          "PRs",
        );
      }

      // ── 타임라인 업데이트 ──
      function updateTimeline() {
        const pips = document.querySelectorAll(".step-pip");
        pips.forEach((pip, i) => {
          pip.classList.remove("done", "current");
          if (i < currentStep) pip.classList.add("done");
          else if (i === currentStep) pip.classList.add("current");
        });
        document.getElementById("timelineInfo").textContent =
          `${currentStep + 1} / ${simData.total_steps} steps`;
      }

      // ── 이벤트 로그 ──
      function addLog(snap) {
        const log = document.getElementById("eventLog");
        let msg = "",
          cls = "";

        if (snap.step % 10 === 1) {
          msg = `Sprint ${snap.sprint} 시작 · Planning`;
          cls = "success";
        } else if (snap.step % 10 === 0) {
          msg = `Sprint ${snap.sprint} 종료 · Retrospective`;
          cls = "success";
        } else if (
          snap.metrics.incidents >
          (simData.snapshots[currentStep - 1]?.metrics.incidents || 0)
        ) {
          msg = "인시던트 발생 ⚡";
          cls = "danger";
        } else if (
          snap.metrics.deployments >
          (simData.snapshots[currentStep - 1]?.metrics.deployments || 0)
        ) {
          msg = "배포 완료 ✓";
          cls = "";
        } else {
          const flowing = snap.agents.filter(
            (a) => a.state === "FlowCoding",
          ).length;
          if (flowing > 0) {
            msg = `FlowCoding ×${flowing} 🔥`;
            cls = "success";
          } else return;
        }

        if (!msg) return;
        const line = document.createElement("div");
        line.className = "log-line";
        line.innerHTML = `<span class="log-step">S${snap.step}</span><span class="log-msg ${cls}">${msg}</span>`;
        log.insertBefore(line, log.firstChild);
        while (log.children.length > 12) log.removeChild(log.lastChild);
      }

      // ── 화면 전환 ──
      function toggleView() {
        const resultView = document.getElementById("prismResultView");
        if (currentView === "simulation") {
          renderPrismResult();
          resultView.classList.add("visible");
          document.getElementById("toggleViewBtn").textContent =
            "◀ 시뮬레이션 보기";
          currentView = "prism";
        } else {
          resultView.classList.remove("visible");
          document.getElementById("toggleViewBtn").textContent =
            "📊 PRISM 결과 보기";
          currentView = "simulation";
        }
      }

      // ── PRISM 결과 화면 렌더링 ──
      function renderPrismResult() {
        if (!simData) return;
        const fw = simData.prism;
        const params = simData.params;

        document.getElementById("resultSubtitle").textContent =
          `${simData.total_steps} Steps · ${simData.num_sprints} Sprints 완료`;

        // ── 벤치마크 데이터 (DORA / DX Core 4) ──
        const BENCHMARKS = {
          "PRs per Engineer": {
            source: "DX Core 4",
            type: "percentile",
            higherBetter: true,
            p90: 4.3,
            p75: 4.0,
            p50: 3.5,
            ref: "All Companies P90=4.3 / P75=4.0 / P50=3.5",
          },
          "Lead Time (steps)": {
            source: "DORA",
            type: "grade",
            higherBetter: false,
            elite: 1,
            high: 5,
            medium: 20,
            ref: "Elite:<1일 / High:<1주 / Medium:<1월 / Low:1월+",
          },
          "Deployment Frequency": {
            source: "DORA · DX Core 4",
            type: "grade",
            higherBetter: true,
            elite: 10,
            high: 2,
            medium: 0.5,
            ref: "Elite:多회/일 / High:1회/일~주 / Medium:1회/주~월",
          },
          "Change Failure Rate (%)": {
            source: "DORA · DX Core 4",
            type: "both",
            higherBetter: false,
            elite: 5,
            high: 10,
            medium: 20,
            p90: 3.0,
            p75: 3.4,
            p50: 4.0,
            ref: "DORA Elite:<5% / DX Core 4 P90=3.0% P75=3.4% P50=4.0%",
          },
          "Recovery Time (steps)": {
            source: "DORA",
            type: "grade",
            higherBetter: false,
            elite: 1,
            high: 3,
            medium: 7,
            ref: "Elite:<1시간 / High:<1일 / Medium:<1일 / Low:1주~1월",
          },
          "% Time on New Capabilities": {
            source: "DX Core 4",
            type: "percentile",
            higherBetter: true,
            p90: 66.1,
            p75: 61.6,
            p50: 59.2,
            ref: "All Companies P90=66.1% / P75=61.6% / P50=59.2%",
          },
        };

        function getBenchmark(key, value) {
          const b = BENCHMARKS[key];
          if (!b) return { label: "", cls: "", source: "", ref: "" };
          let label = "",
            cls = "";

          if (b.type === "percentile") {
            if (b.higherBetter) {
              if (value >= b.p90) {
                label = "P90+";
                cls = "bench-p90";
              } else if (value >= b.p75) {
                label = "P75+";
                cls = "bench-p75";
              } else if (value >= b.p50) {
                label = "P50+";
                cls = "bench-p50";
              } else {
                label = "P50−";
                cls = "bench-below";
              }
            } else {
              if (value <= b.p90) {
                label = "P90+";
                cls = "bench-p90";
              } else if (value <= b.p75) {
                label = "P75+";
                cls = "bench-p75";
              } else if (value <= b.p50) {
                label = "P50+";
                cls = "bench-p50";
              } else {
                label = "P50−";
                cls = "bench-below";
              }
            }
          } else {
            if (!b.higherBetter) {
              if (value <= b.elite) {
                label = "Elite";
                cls = "bench-elite";
              } else if (value <= b.high) {
                label = "High";
                cls = "bench-high";
              } else if (value <= b.medium) {
                label = "Medium";
                cls = "bench-medium";
              } else {
                label = "Low";
                cls = "bench-low";
              }
            } else {
              if (value >= b.elite) {
                label = "Elite";
                cls = "bench-elite";
              } else if (value >= b.high) {
                label = "High";
                cls = "bench-high";
              } else if (value >= b.medium) {
                label = "Medium";
                cls = "bench-medium";
              } else {
                label = "Low";
                cls = "bench-low";
              }
            }
          }
          return { label, cls, source: b.source, ref: b.ref };
        }

        function getBaseline() {
          return {
            "PRs per Engineer":
              parseFloat(document.getElementById("b-prs").value) || null,
            "Lead Time (steps)":
              parseFloat(document.getElementById("b-lt").value) || null,
            "Deployment Frequency":
              parseFloat(document.getElementById("b-df").value) || null,
            "Change Failure Rate (%)":
              parseFloat(document.getElementById("b-cfr").value) || null,
            "Recovery Time (steps)":
              parseFloat(document.getElementById("b-rt").value) || null,
            "% Time on New Capabilities":
              parseFloat(document.getElementById("b-nc").value) || null,
          };
        }

        function getDelta(key, simValue, baseline) {
          const bVal = baseline[key];
          if (bVal === null) return null;
          const b = BENCHMARKS[key];
          const diff = simValue - bVal;
          const pct = bVal !== 0 ? ((diff / bVal) * 100).toFixed(1) : "—";
          const improved = b
            ? b.higherBetter
              ? diff > 0
              : diff < 0
            : diff > 0;
          const sign = diff > 0 ? "+" : "";
          return {
            diff: `${sign}${diff.toFixed(2)}`,
            pct: pct === "—" ? "—" : `${sign}${pct}%`,
            improved,
            cls: improved
              ? "delta-positive"
              : diff === 0
                ? "delta-neutral"
                : "delta-negative",
            arrow: improved ? "▲" : diff === 0 ? "–" : "▼",
          };
        }

        const cardAccents = {
          "PRs per Engineer": "#3b82f6",
          "Lead Time (steps)": "#8b5cf6",
          "Deployment Frequency": "#06b6d4",
          "Change Failure Rate (%)": "#ef4444",
          "Recovery Time (steps)": "#f59e0b",
          "% Time on New Capabilities": "#10b981",
        };

        const units = {
          "PRs per Engineer": "",
          "Lead Time (steps)": "step",
          "Deployment Frequency": "/sprint",
          "Change Failure Rate (%)": "%",
          "Recovery Time (steps)": "step",
          "% Time on New Capabilities": "%",
        };

        const baseline = getBaseline();
        const cardsEl = document.getElementById("prismCards");
        cardsEl.innerHTML = "";
        Object.entries(fw).forEach(([key, value]) => {
          const bench = getBenchmark(key, value);
          const delta = getDelta(key, value, baseline);
          const accent = cardAccents[key] || "#3b82f6";
          const unit = units[key] || "";

          const deltaHTML = delta
            ? `<div class="${delta.cls}" style="margin-top:6px">
           ${delta.arrow} ${delta.diff}${unit} (${delta.pct}) vs Baseline
         </div>`
            : "";

          const benchHTML = bench.label
            ? `<div class="prism-card-bench" style="margin-top:8px">
           <span class="bench-source">${bench.source}</span><span class="bench-badge ${bench.cls}">${bench.label}</span>
           <div style="font-size:9px;color:var(--text3);margin-top:4px">${bench.ref}</div>
         </div>`
            : "";

          cardsEl.innerHTML += `
      <div class="prism-card" style="--card-accent:${accent}">
        <div class="prism-card-label">${key.replace(" (%)", "").replace(" (steps)", "")}</div>
        <div class="prism-card-value">${value}<span class="prism-card-unit">${unit}</span></div>
        ${deltaHTML}
        ${benchHTML}
      </div>`;
        });

        const paramLabels = {
          num_developers: "개발자 수",
          num_sprints: "스프린트 수",
          meeting_load: "회의 부하(분)",
          review_strictness: "리뷰 엄격도",
          codebase_stability: "코드 안정성",
          collaboration_tendency: "협업 성향",
          requirement_clarity: "요구사항 명확도",
          seed: "랜덤 시드",
        };

        const paramsEl = document.getElementById("prismParamsGrid");
        paramsEl.innerHTML = "";
        Object.entries(params).forEach(([key, value]) => {
          paramsEl.innerHTML += `
      <div class="param-chip">
        <span class="param-chip-label">${paramLabels[key] || key}</span>
        <span class="param-chip-value">${value}</span>
      </div>`;
        });
      }

      // ── 애니메이션 ──
      let playing = false;
      function playAnimation() {
        if (!simData) return;
        if (playing) {
          clearInterval(animTimer);
          playing = false;
          document.getElementById("playBtn").textContent = "⏵ 애니메이션 재생";
          return;
        }
        playing = true;
        document.getElementById("playBtn").textContent = "⏸ 일시정지";
        if (currentStep >= simData.snapshots.length - 1) currentStep = 0;
        animTimer = setInterval(() => {
          if (currentStep >= simData.snapshots.length - 1) {
            clearInterval(animTimer);
            playing = false;
            document.getElementById("playBtn").textContent =
              "⏵ 애니메이션 재생";
            return;
          }
          currentStep++;
          renderStep(simData.snapshots[currentStep]);
          updateTimeline();
          updateCharts();
        }, 200);
      }

      // ── 테마 토글 ──
      function toggleTheme() {
        const isLight = document.documentElement.classList.toggle("light");
        document.getElementById("themeIcon").textContent = isLight ? "☽" : "☀";
        localStorage.setItem("theme", isLight ? "light" : "dark");
      }

      // 초기 실행
      window.addEventListener("load", () => {
        if (localStorage.getItem("theme") === "light") {
          document.documentElement.classList.add("light");
          document.getElementById("themeIcon").textContent = "☽";
        }
        runSimulation();
      });
    </script>
  </body>
</html>
